body {
  margin: 0;
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  background: #f3f5f9;
  color: #172033;
}

.app-shell {
  min-height: 100vh;
}

.dashboard-navbar {
  background: #111827;
  min-height: 64px;
}

.hero-section {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  padding: 28px;
}

.stat-card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  padding: 22px;
  height: 100%;
}

.stat-card strong {
  display: block;
  font-size: 2rem;
  margin-top: 5px;
}

.stat-label {
  color: #6b7280;
  font-size: 0.9rem;
}

.filter-card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  padding: 20px;
}

.filter-switch {
  padding-top: 10px;
}

/* =========================
   JOB CARDS
========================= */

.job-card {
  background: #ffffff;
  border: 1px solid #dfe3ea;
  border-radius: 20px;
  padding: 22px;
  display: flex;
  flex-direction: column;
  min-height: 560px;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    border-color 0.18s ease;
}

.job-card:hover {
  transform: translateY(-4px);
  border-color: #b8c4d6;
  box-shadow: 0 14px 32px rgba(15, 23, 42, 0.11);
}

.job-title {
  font-size: 1.18rem;
  line-height: 1.35;
  font-weight: 750;
  margin-bottom: 6px;
}

.company-name {
  color: #4b5563;
  font-weight: 600;
}

.badge-recommended {
  background: #dcfce7;
  color: #166534;
}

.badge-review {
  background: #fef3c7;
  color: #92400e;
}

.badge-rejected {
  background: #fee2e2;
  color: #991b1b;
}

/* Score */

.score-circle {
  min-width: 70px;
  width: 70px;
  height: 70px;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4px solid;
}

.score-circle strong {
  font-size: 1rem;
}

.score-circle small {
  font-size: 0.65rem;
}

.score-high {
  border-color: #22c55e;
  color: #15803d;
}

.score-medium {
  border-color: #f59e0b;
  color: #b45309;
}

.score-low {
  border-color: #ef4444;
  color: #b91c1c;
}

/* Información */

.job-info {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
  margin: 20px 0;
}

.job-info div {
  background: #f8fafc;
  border-radius: 10px;
  padding: 10px;
}

.job-info span {
  display: block;
  color: #6b7280;
  font-size: 0.7rem;
  margin-bottom: 3px;
}

.job-info strong {
  display: block;
  font-size: 0.8rem;
}

.description {
  color: #4b5563;
  font-size: 0.86rem;
  line-height: 1.5;
  min-height: 78px;
}

/* Skills */

.skills-section {
  margin-top: 12px;
}

.skills-title {
  font-size: 0.78rem;
  font-weight: 700;
  color: #4b5563;
  margin-bottom: 8px;
}

.skill {
  display: inline-flex;
  padding: 5px 8px;
  border-radius: 8px;
  font-size: 0.72rem;
  font-weight: 600;
}

.skill-matched {
  background: #dcfce7;
  color: #166534;
}

.skill-missing {
  background: #fef3c7;
  color: #92400e;
}

/* Botones */

.job-actions {
  margin-top: auto;
  padding-top: 20px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.job-actions .application-status {
  grid-column: 1 / -1;
}

.application-status {
  width: 100%;
}

.application-note {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #e5e7eb;
  color: #6b7280;
  font-size: 0.78rem;
}

.empty-state {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  padding: 60px 20px;
  text-align: center;
}

@media (max-width: 767px) {
  .job-card {
    min-height: auto;
  }

  .job-actions {
    grid-template-columns: 1fr;
  }

  .job-actions .application-status {
    grid-column: auto;
  }
}
