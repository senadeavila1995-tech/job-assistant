import { useEffect, useMemo, useState } from 'react'
import Swal from 'sweetalert2'
import type { Application, Job, Match } from './types'

const STATUS_OPTIONS = [
  'SELECCIONADA',
  'POSTULACION_PREPARADA',
  'POSTULADA',
  'EN_REVISION',
  'ENTREVISTA',
  'OFERTA_RECIBIDA',
  'ACEPTADA',
  'RECHAZADA',
  'DESCARTADA',
  'CERRADA',
]

function App() {
  const [jobs, setJobs] = useState<Job[]>([])
  const [matches, setMatches] = useState<Match[]>([])
  const [applications, setApplications] = useState<Application[]>([])
  const [loading, setLoading] = useState(true)
  const [search, setSearch] = useState('')
  const [source, setSource] = useState('TODAS')
  const [minScore, setMinScore] = useState(60)
  const [remoteOnly, setRemoteOnly] = useState(false)

  async function loadData() {
    try {
      setLoading(true)

      const [jobsResponse, matchesResponse, applicationsResponse] =
        await Promise.all([
          fetch('/api/jobs'),
          fetch('/api/matches'),
          fetch('/api/applications'),
        ])

      if (!jobsResponse.ok || !matchesResponse.ok || !applicationsResponse.ok) {
        throw new Error('No se pudieron cargar los datos')
      }

      const [jobsData, matchesData, applicationsData] = await Promise.all([
        jobsResponse.json(),
        matchesResponse.json(),
        applicationsResponse.json(),
      ])

      setJobs(jobsData)
      setMatches(matchesData)
      setApplications(applicationsData)
    } catch (error) {
      console.error(error)

      await Swal.fire({
        icon: 'error',
        title: 'Error de conexión',
        text: 'No fue posible conectar con el backend de Job Assistant.',
      })
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    loadData()
  }, [])

  const jobMap = useMemo(
    () => new Map(jobs.map((job) => [job.id, job])),
    [jobs],
  )

  const applicationMap = useMemo(
    () => new Map(applications.map((application) => [application.job_id, application])),
    [applications],
  )

  const sources = useMemo(
    () => ['TODAS', ...Array.from(new Set(jobs.map((job) => job.source)))],
    [jobs],
  )

  const filteredMatches = useMemo(() => {
    const normalizedSearch = search.trim().toLowerCase()

    return matches.filter((match) => {
      const job = jobMap.get(match.job_id)

      if (!job) return false

      const matchesScore = match.score >= minScore
      const matchesSource = source === 'TODAS' || job.source === source
      const matchesRemote = !remoteOnly || job.remote

      const matchesSearch =
        !normalizedSearch ||
        job.title.toLowerCase().includes(normalizedSearch) ||
        job.company.toLowerCase().includes(normalizedSearch) ||
        (job.description ?? '').toLowerCase().includes(normalizedSearch) ||
        match.job_skills.some((skill) =>
          skill.toLowerCase().includes(normalizedSearch),
        )

      return (
        matchesScore &&
        matchesSource &&
        matchesRemote &&
        matchesSearch
      )
    })
  }, [matches, jobMap, minScore, source, remoteOnly, search])

  const recommendedCount = matches.filter(
    (match) => match.recommendation === 'RECOMENDADA',
  ).length

  const selectedCount = applications.filter(
    (application) => application.status !== 'CERRADA',
  ).length

  async function selectJob(job: Job, match: Match) {
    try {
      const response = await fetch('/api/applications', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          job_id: job.id,
          source: job.source,
          application_url: job.url,
          notes: `Oferta seleccionada automáticamente con score ${match.score.toFixed(2)}%.`,
        }),
      })

      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.detail || 'No se pudo seleccionar la oferta')
      }

      await Swal.fire({
        icon: 'success',
        title: 'Oferta seleccionada',
        text: 'La oferta fue agregada a tu seguimiento.',
        confirmButtonText: 'Perfecto',
      })

      await loadData()
    } catch (error) {
      await Swal.fire({
        icon: 'error',
        title: 'No se pudo seleccionar',
        text: error instanceof Error ? error.message : 'Error desconocido',
      })
    }
  }

  async function updateStatus(application: Application, status: string) {
    try {
      const response = await fetch(
        `/api/applications/${application.id}/status`,
        {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ status }),
        },
      )

      const data = await response.json()

      if (!response.ok) {
        throw new Error(data.detail || 'No se pudo actualizar el estado')
      }

      await loadData()
    } catch (error) {
      await Swal.fire({
        icon: 'error',
        title: 'Error',
        text: error instanceof Error ? error.message : 'Error desconocido',
      })
    }
  }

  function openApplication(job: Job) {
    if (!job.url) {
      Swal.fire({
        icon: 'warning',
        title: 'URL no disponible',
        text: 'Esta oferta todavía no tiene una URL de postulación registrada.',
      })
      return
    }

    window.open(job.url, '_blank', 'noopener,noreferrer')
  }

  function recommendationClass(recommendation: string) {
    if (recommendation === 'RECOMENDADA') return 'badge-recommended'
    if (recommendation === 'REVISAR') return 'badge-review'
    return 'badge-rejected'
  }

  function scoreClass(score: number) {
    if (score >= 80) return 'score-high'
    if (score >= 60) return 'score-medium'
    return 'score-low'
  }

  return (
    <div className="app-shell">
      <nav className="navbar navbar-dark dashboard-navbar">
        <div className="container-fluid px-4">
          <div>
            <span className="navbar-brand fw-bold">
              Job Assistant
            </span>
            <span className="navbar-text text-white-50 d-none d-md-inline">
              Analizador inteligente de ofertas
            </span>
          </div>

          <button
            className="btn btn-outline-light btn-sm"
            onClick={loadData}
          >
            ↻ Actualizar
          </button>
        </div>
      </nav>

      <main className="container-fluid px-4 py-4">
        <section className="hero-section mb-4">
          <div>
            <h1 className="fw-bold mb-2">
              Ofertas compatibles con tu perfil
            </h1>
            <p className="text-secondary mb-0">
              Job Assistant analiza habilidades, rol, salario y modalidad
              para ayudarte a priorizar dónde postularte.
            </p>
          </div>
        </section>

        <section className="row g-3 mb-4">
          <div className="col-md-4">
            <div className="stat-card">
              <span className="stat-label">Ofertas analizadas</span>
              <strong>{matches.length}</strong>
            </div>
          </div>

          <div className="col-md-4">
            <div className="stat-card">
              <span className="stat-label">Recomendadas</span>
              <strong>{recommendedCount}</strong>
            </div>
          </div>

          <div className="col-md-4">
            <div className="stat-card">
              <span className="stat-label">En seguimiento</span>
              <strong>{selectedCount}</strong>
            </div>
          </div>
        </section>

        <section className="filter-card mb-4">
          <div className="row g-3 align-items-end">
            <div className="col-lg-4">
              <label className="form-label fw-semibold">
                Buscar
              </label>
              <input
                type="text"
                className="form-control"
                placeholder="React, Node, Full Stack, empresa..."
                value={search}
                onChange={(event) => setSearch(event.target.value)}
              />
            </div>

            <div className="col-lg-2">
              <label className="form-label fw-semibold">
                Fuente
              </label>
              <select
                className="form-select"
                value={source}
                onChange={(event) => setSource(event.target.value)}
              >
                {sources.map((item) => (
                  <option key={item} value={item}>
                    {item}
                  </option>
                ))}
              </select>
            </div>

            <div className="col-lg-2">
              <label className="form-label fw-semibold">
                Score mínimo
              </label>
              <select
                className="form-select"
                value={minScore}
                onChange={(event) => setMinScore(Number(event.target.value))}
              >
                <option value={0}>Todas</option>
                <option value={60}>60%+</option>
                <option value={80}>80%+</option>
                <option value={90}>90%+</option>
              </select>
            </div>

            <div className="col-lg-4">
              <div className="form-check form-switch filter-switch">
                <input
                  className="form-check-input"
                  type="checkbox"
                  id="remoteOnly"
                  checked={remoteOnly}
                  onChange={(event) => setRemoteOnly(event.target.checked)}
                />
                <label
                  className="form-check-label fw-semibold"
                  htmlFor="remoteOnly"
                >
                  Mostrar solamente ofertas remotas
                </label>
              </div>
            </div>
          </div>
        </section>

        {loading ? (
          <div className="text-center py-5">
            <div className="spinner-border" role="status" />
            <p className="mt-3 text-secondary">
              Analizando ofertas...
            </p>
          </div>
        ) : filteredMatches.length === 0 ? (
          <div className="empty-state">
            <h4>No hay ofertas con estos filtros</h4>
            <p className="text-secondary mb-0">
              Prueba reduciendo el score mínimo o cambiando la búsqueda.
            </p>
          </div>
        ) : (
          <div className="row g-4">
            {filteredMatches.map((match) => {
              const job = jobMap.get(match.job_id)

              if (!job) return null

              const application = applicationMap.get(job.id)

              return (
                <div className="col-12 col-md-6 col-xl-4 d-flex" key={job.id}>
                  <article className="job-card w-100">
                    <div className="d-flex justify-content-between gap-3">
                      <div>
                        <div className="d-flex flex-wrap gap-2 mb-2">
                          <span
                            className={`badge ${recommendationClass(
                              match.recommendation,
                            )}`}
                          >
                            {match.recommendation}
                          </span>

                          <span className="badge text-bg-light">
                            {job.source}
                          </span>

                          {job.remote && (
                            <span className="badge text-bg-success">
                              REMOTO
                            </span>
                          )}
                        </div>

                        <h3 className="job-title">
                          {job.title}
                        </h3>

                        <p className="company-name mb-2">
                          {job.company}
                        </p>
                      </div>

                      <div
                        className={`score-circle ${scoreClass(match.score)}`}
                      >
                        <strong>{Math.round(match.score)}%</strong>
                        <small>match</small>
                      </div>
                    </div>

                    <div className="job-info">
                      <div>
                        <span>💰 Salario</span>
                        <strong>
                          {job.salary || 'No especificado'}
                        </strong>
                      </div>

                      <div>
                        <span>🎯 Rol</span>
                        <strong>
                          {Math.round(match.role_score)}%
                        </strong>
                      </div>

                      <div>
                        <span>🧠 Skills</span>
                        <strong>
                          {Math.round(match.skill_score)}%
                        </strong>
                      </div>

                      <div>
                        <span>🌎 Modalidad</span>
                        <strong>
                          {job.remote ? 'Remoto' : 'Presencial'}
                        </strong>
                      </div>
                    </div>

                    {job.description && (
                      <p className="description">
                        {job.description.length > 240
                          ? `${job.description.substring(0, 240)}...`
                          : job.description}
                      </p>
                    )}

                    <div className="skills-section">
                      <div className="skills-title">
                        Habilidades encontradas
                      </div>

                      <div className="d-flex flex-wrap gap-2">
                        {match.matched_skills.map((skill) => (
                          <span
                            className="skill skill-matched"
                            key={skill}
                          >
                            ✓ {skill}
                          </span>
                        ))}

                        {match.missing_skills.map((skill) => (
                          <span
                            className="skill skill-missing"
                            key={skill}
                          >
                            + {skill}
                          </span>
                        ))}
                      </div>
                    </div>

                    <div className="job-actions">
                      <button
                        className="btn btn-outline-secondary"
                        onClick={() => openApplication(job)}
                        disabled={!job.url}
                      >
                        Ver oferta
                      </button>

                      <button
                        className="btn btn-primary"
                        onClick={() => openApplication(job)}
                        disabled={!job.url}
                      >
                        🚀 Postularme
                      </button>

                      {!application ? (
                        <button
                          className="btn btn-outline-primary"
                          onClick={() => selectJob(job, match)}
                        >
                          ☆ Seguimiento
                        </button>
                      ) : (
                        <select
                          className="form-select application-status"
                          value={application.status}
                          onChange={(event) =>
                            updateStatus(
                              application,
                              event.target.value,
                            )
                          }
                        >
                          {STATUS_OPTIONS.map((status) => (
                            <option key={status} value={status}>
                              {status.replaceAll('_', ' ')}
                            </option>
                          ))}
                        </select>
                      )}
                    </div>

                    {application && (
                      <div className="application-note">
                        Seguimiento: <strong>
                          {application.status.replaceAll('_', ' ')}
                        </strong>
                      </div>
                    )}
                  </article>
                </div>
              )
            })}
          </div>
        )}
      </main>
    </div>
  )
}

export default App
